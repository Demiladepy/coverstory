# Copy to .env.local for development, and set the same names in your host's
# environment for a deploy. .env.local is gitignored; this file is not, so it
# must never hold a real key.

# The only secret. It stays on the server: the browser is handed short-lived
# tokens from /api/token and talks to AssemblyAI directly with those.
ASSEMBLYAI_API_KEY=

# Nights one browser may start in an hour. An address may start five times
# this number, because the place this link is most likely to be opened by
# several people at once is a room full of people on one wifi — and locking
# that room out is the worst thing this guard could do.
#
# Five rather than three: a night is about six minutes of streaming, and
# somebody caught at the first door deserves another go without being shut
# out. A night costs one run however many doors it opens; the address cap is
# what actually stops a farm.
MAX_RUNS_PER_BROWSER_PER_HOUR=5

# Hard cap on a single door's session, in seconds, applied to the minted
# tokens themselves.
#
# Streaming bills for as long as its socket is open, idle or not — the API
# docs call unclosed sessions the commonest cause of a surprise invoice. Each
# door opens and closes its own session, so this is what an abandoned tab
# costs: one door, not a whole night. The longest door runs about three
# minutes, so this leaves room without leaving much to lose.
MAX_RUN_SECONDS=420
