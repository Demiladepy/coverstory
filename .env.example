# Copy to .env.local for development, and set the same names in your host's
# environment for a deploy. .env.local is gitignored; this file is not, so it
# must never hold a real key.

# The only secret. It stays on the server: the browser is handed short-lived
# tokens from /api/token and talks to AssemblyAI directly with those.
ASSEMBLYAI_API_KEY=

# Runs one browser may start in an hour. This exists to stop a public link
# being farmed, not to protect a margin — a run is about $0.03 of speech.
# A run is now a whole night of four visitors, so there are fewer of them.
# Raise it locally while you are testing.
MAX_RUNS_PER_BROWSER_PER_HOUR=3

# Hard cap on a single run, in seconds, applied to the minted tokens
# themselves. A streaming session is billed for as long as the socket is open,
# so a tab left on a desk must not be able to bill all night. A full night of
# four visitors takes about nine minutes, prep included; this leaves room.
MAX_RUN_SECONDS=1200
